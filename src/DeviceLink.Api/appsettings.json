{
  "Urls": "http://localhost:5100",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.AspNetCore": "Warning",
        "Grpc": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
