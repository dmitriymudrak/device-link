<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Google.Protobuf" Version="3.36.2" />
		<PackageReference Include="Grpc.Net.Client" Version="2.85.0" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="11.0.0" />
		<PackageReference Include="Grpc.Tools" Version="2.85.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\DeviceLink.Protocol\DeviceLink.Protocol.csproj" />
	</ItemGroup>
	<ItemGroup>
		<!-- Client stubs are generated here from the Api contract; no reference to the Api project itself. -->
		<Protobuf Include="..\DeviceLink.Api\Protos\devicelink.proto" GrpcServices="Client" />
	</ItemGroup>

</Project>